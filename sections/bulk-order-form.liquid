{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="title title-wrapper--no-top-margin">{{ section.settings.heading }}</h1>
    {%- if section.settings.intro != blank -%}
      <div class="rte">{{ section.settings.intro }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'BulkOrderForm', class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ section.settings.success_message }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message" role="alert">
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Request type]" value="Bulk order">
      <input type="hidden" name="contact[tags]" value="bulk-order">
      <div class="contact__fields">
        {% render 'request-field', form_id: 'BulkOrderForm', key: 'Name', label: 'Name', required: true, autocomplete: 'name', value: form.name %}
        {% render 'request-field', form_id: 'BulkOrderForm', key: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email', value: form.email %}
      </div>
      <div class="contact__fields">
        {% render 'request-field', form_id: 'BulkOrderForm', key: 'Phone', label: 'Phone', type: 'tel', autocomplete: 'tel' %}
        {% render 'request-field', form_id: 'BulkOrderForm', key: 'Company or property', label: 'Company or property', autocomplete: 'organization' %}
      </div>
      {% render 'request-field', form_id: 'BulkOrderForm', key: 'Quantity needed', label: 'About how many tags?', type: 'number' %}
      {% render 'request-field', form_id: 'BulkOrderForm', key: 'body', label: 'What do you need?', type: 'textarea', required: true %}

      <div class="contact__button">
        <button type="submit" class="button">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}

    <div class="bulk-order__photos rte">
      <h2 class="h4">{{ section.settings.photos_heading }}</h2>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- else -%}
        <p>
          {{ section.settings.photos_fallback }}
          {%- if shop.email != blank %}
            <a href="mailto:{{ shop.email }}?subject=Bulk%20order%20photos">{{ shop.email }}</a>
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .bulk-order__photos {
    margin-top: 3rem;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Bulk order form",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bulk and custom orders"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Need tags for a whole building, a team or a parking garage? Tell us what you have and how many you need, and we'll send you a quote.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request a quote"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We got your request and will reply with a quote."
    },
    {
      "type": "text",
      "id": "photos_heading",
      "label": "Photos heading",
      "default": "Send us photos"
    },
    {
      "type": "text",
      "id": "photos_fallback",
      "label": "Photo instructions (shown when no upload app block is added)",
      "default": "Email photos of your tags, front and back, with your name to"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Bulk order form"
    }
  ]
}
{% endschema %}
