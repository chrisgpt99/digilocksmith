{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'clone-order.js' | asset_url }}" defer="defer"></script>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="contact page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="title title-wrapper--no-top-margin">{{ section.settings.heading }}</h1>
    <div class="rte">{{ section.settings.intro }}</div>

    <local-zip-check class="local-service__check" data-zip-prefixes="{{ settings.local_zip_prefixes | escape }}">
      <label class="local-service__label" for="LocalZipCheck-{{ section.id }}">Check your ZIP code</label>
      <div class="local-service__row">
        <input
          id="LocalZipCheck-{{ section.id }}"
          class="field__input local-service__zip"
          type="text"
          inputmode="numeric"
          maxlength="5"
          placeholder="ZIP code"
        >
      </div>
      <p class="local-service__result" aria-live="polite"></p>
    </local-zip-check>

    <h2 class="h3">{{ section.settings.form_heading }}</h2>
    {%- form 'contact', id: 'LocalVisitForm', class: 'isolate' -%}
      {%- if form.posted_successfully? -%}
        <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
          {{- 'icon-success.svg' | inline_asset_content -}}
          {{ section.settings.success_message }}
        </h2>
      {%- elsif form.errors -%}
        <div class="form__message" role="alert">
          {{- 'icon-error.svg' | inline_asset_content -}}
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <input type="hidden" name="contact[Request type]" value="Local visit">
      <input type="hidden" name="contact[tags]" value="local-visit">
      <div class="contact__fields">
        {% render 'request-field', form_id: 'LocalVisitForm', key: 'Name', label: 'Name', required: true, autocomplete: 'name', value: form.name %}
        {% render 'request-field', form_id: 'LocalVisitForm', key: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email', value: form.email %}
      </div>
      <div class="contact__fields">
        {% render 'request-field', form_id: 'LocalVisitForm', key: 'Phone', label: 'Phone', type: 'tel', required: true, autocomplete: 'tel' %}
        {% render 'request-field', form_id: 'LocalVisitForm', key: 'ZIP code', label: 'ZIP code', required: true, autocomplete: 'postal-code' %}
      </div>
      {% render 'request-field', form_id: 'LocalVisitForm', key: 'Best days and times', label: 'Best days and times' %}
      {% render 'request-field', form_id: 'LocalVisitForm', key: 'body', label: 'What needs copying, and how many?', type: 'textarea', required: true %}

      <div class="contact__button">
        <button type="submit" class="button">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

<script>
  if (!customElements.get('local-zip-check')) {
    customElements.define(
      'local-zip-check',
      class LocalZipCheck extends HTMLElement {
        connectedCallback() {
          const input = this.querySelector('input');
          const result = this.querySelector('.local-service__result');
          input.addEventListener('input', () => {
            const served = window.DigiLocalZip?.isServed(input.value, this.dataset.zipPrefixes);
            if (served === true) result.textContent = {{ section.settings.in_area_message | json }};
            else if (served === false) result.textContent = {{ section.settings.out_of_area_message | json }};
            else result.textContent = '';
          });
        }
      }
    );
  }
</script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .local-service__check {
    display: block;
    margin: 2.4rem 0 3.2rem;
    padding: 1.6rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.15);
    border-radius: var(--inputs-radius, 0.4rem);
  }
  .local-service__label {
    display: block;
    font-weight: 600;
    margin-bottom: 0.8rem;
  }
  .local-service__zip {
    max-width: 16rem;
    padding: 1rem 1.2rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.4);
    border-radius: var(--inputs-radius, 0.4rem);
    font-size: 1.6rem;
  }
  .local-service__result {
    margin: 0.8rem 0 0;
    min-height: 1.6em;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Local service",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "On-the-spot copying near you"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>We come to you within 100 miles of Santa Ana (92704) and copy your fob, card or parking tag on the spot. You keep your original the whole time.</p>"
    },
    {
      "type": "text",
      "id": "in_area_message",
      "label": "In-area message",
      "default": "Good news, you're in our local service area. Request a visit below."
    },
    {
      "type": "text",
      "id": "out_of_area_message",
      "label": "Out-of-area message",
      "default": "That ZIP is outside our local area, but you can still order online by serial number or mail-in."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Request a visit"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request a visit"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks! We'll call or text you to set a time."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Local service"
    }
  ]
}
{% endschema %}
