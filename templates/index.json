    "how_it_works": {
      "type": "multicolumn",
      "blocks": {
        "step1": {
          "type": "column",
          "settings": {
            "title": "1. Snap a photo",
            "text": "<p>Pick your tag type and upload a photo of your key so we know exactly what you have.</p>"
          }
        },
        "step2": {
          "type": "column",
          "settings": {
            "title": "2. Choose how we copy it",
            "text": "<p>Give us the serial number, mail in your key, or book a local visit within 100 miles of 92704.</p>"
          }
        },
        "step3": {
          "type": "column",
          "settings": {
            "title": "3. Get your copy",
            "text": "<p>We test every copy before it ships. If we can't copy it, you get your money back.</p>"
          }
        }
      },
      "block_order": [
        "step1",
        "step2",
        "step3"
