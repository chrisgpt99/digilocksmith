          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Upload a photo, pay per tag, and get an exact working copy. Keep your original with a serial number, mail it in, or have us copy it on the spot near Santa Ana.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "button_label": "Start my order",
            "button_link": "/collections/all",
            "button_style_secondary": false,
            "button_label_2": "Local service",
            "button_link_2": "/pages/local-service",
            "button_style_secondary_2": true
          }
        }
      },
