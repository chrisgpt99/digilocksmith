    "faq": {
      "type": "collapsible-content",
      "blocks": {
        "q0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What can you copy?",
            "icon": "question_mark",
            "row_content": "<p>Most apartment and condo key fobs, building key cards, stickers, UHF parking tags and many garage remotes. Send a photo with your order and we'll confirm before we start.</p>"
          }
        },
        "q1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do I have to mail in my key?",
            "icon": "question_mark",
            "row_content": "<p>Usually not. Many tags can be copied from the number printed on them. If yours can't, choose mail-in and we'll ship your copy and your original back together. Near Santa Ana? Book a local visit instead.</p>"
          }
        },
        "q2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What if my key can't be copied?",
            "icon": "question_mark",
            "row_content": "<p>You get a full refund of the tag price, and if you mailed it in we return your original at our cost.</p>"
          }
        },
        "q3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Can I get it as a card or sticker instead of a fob?",
            "icon": "question_mark",
            "row_content": "<p>Yes. Pick the format you want on the product page; the copy works the same way.</p>"
          }
        },
        "q4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Is it legal to copy my building key?",
            "icon": "question_mark",
            "row_content": "<p>You need to own the key or be authorized by your building or property manager. Every order asks you to confirm this.</p>"
          }
        },
        "q5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does it take?",
            "icon": "question_mark",
            "row_content": "<p>Serial-number orders usually ship within one to two business days. Mail-in orders ship back within one to two business days after your key arrives.</p>"
          }
        }
      },
